Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_20

%labels
    Maintainer CodeSpringLab
    Version 1.0.0
    Description Reproducible Seurat runtime for CodeSpringLab single-cell processing

%environment
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_LIBS_USER=/usr/local/lib/R/site-library

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        gfortran \
        libcurl4-openssl-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libfribidi-dev \
        libglpk-dev \
        libgsl-dev \
        libharfbuzz-dev \
        libhdf5-dev \
        libjpeg-dev \
        libpng-dev \
        libssl-dev \
        libtiff-dev \
        libxml2-dev
    rm -rf /var/lib/apt/lists/*

    Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); install.packages("remotes")'
    Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); remotes::install_version("Matrix", version="1.7-4", upgrade="never")'
    Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); remotes::install_version("patchwork", version="1.3.0", upgrade="never"); remotes::install_version("harmony", version="1.2.1", upgrade="never"); remotes::install_version("SeuratObject", version="5.3.0", upgrade="never"); remotes::install_version("Seurat", version="5.4.0", upgrade="never")'
    Rscript -e 'options(repos=c(CRAN="https://cloud.r-project.org")); BiocManager::install(version="3.20", ask=FALSE, update=FALSE); BiocManager::install(c("scDblFinder", "SingleCellExperiment", "SummarizedExperiment", "DESeq2", "fgsea"), ask=FALSE, update=FALSE)'
    Rscript -e 'pkgs <- c("Seurat","SeuratObject","Matrix","sctransform","ggplot2","patchwork","future","harmony","scDblFinder","SingleCellExperiment","SummarizedExperiment","DESeq2","fgsea"); stopifnot(all(vapply(pkgs, requireNamespace, logical(1), quietly=TRUE)))'

%runscript
    exec Rscript "$@"

%test
    Rscript -e 'expected <- c(Seurat="5.4.0", SeuratObject="5.3.0", Matrix="1.7.4", harmony="1.2.1"); stopifnot(all(vapply(names(expected), requireNamespace, logical(1), quietly=TRUE))); actual <- vapply(names(expected), function(x) as.character(packageVersion(x)), character(1)); stopifnot(identical(actual, expected)); stopifnot(all(vapply(c("scDblFinder","DESeq2","fgsea"), requireNamespace, logical(1), quietly=TRUE)))'
